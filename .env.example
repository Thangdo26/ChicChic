# Postgres. Local: docker run --name chicchic-db -e POSTGRES_PASSWORD=chic -e POSTGRES_DB=chicchic -p 5432:5432 -d postgres:16
# Hoặc dùng Supabase/Neon: dán connection string vào đây.
DATABASE_URL="postgresql://postgres:chic@localhost:5432/chicchic?schema=public"

# Thông tin nhận cọc giữ chỗ (hiển thị trong app, đối soát tay ở giai đoạn PoC)
NEXT_PUBLIC_HOLD_BANK="Vietcombank · 0123456789 · DO DINH THANG"
NEXT_PUBLIC_HOLD_MOMO="0900000000"
