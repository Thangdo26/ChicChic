# ---------- Postgres ----------
# Local (Docker): DIRECT_URL = DATABASE_URL
#   docker run --name chicchic-db -e POSTGRES_PASSWORD=chic -e POSTGRES_DB=chicchic -p 5432:5432 -d postgres:16
#
# Supabase: DÙNG POOLER CHO CẢ HAI (host …pooler.supabase.com).
#   DATABASE_URL = Transaction pooler, cổng 6543, thêm ?pgbouncer=true&connection_limit=5
#   DIRECT_URL   = Session pooler,     cổng 5432
#   connection_limit=1 làm MỌI truy vấn xếp hàng một hàng dọc — trang chuồng có nhiều quan hệ
#   nên chậm gấp đôi. Để 5 là vừa (đo được: 9,3s -> 4,6s cho /chuong/<slug>).
#   ⚠️ KHÔNG dùng "Direct connection" (host db.<ref>.supabase.co) — host đó chỉ có IPv6,
#      phần lớn mạng ở VN không kết nối được → lỗi P1001.
DATABASE_URL="postgresql://postgres:chic@localhost:5432/chicchic?schema=public"
DIRECT_URL="postgresql://postgres:chic@localhost:5432/chicchic?schema=public"

# ---------- Nhận cọc giữ chỗ (hiển thị trong app, đối soát tay ở giai đoạn PoC) ----------
# Chuỗi tự do, hiện nguyên văn trên nút "Sao chép" ở banner cọc.
NEXT_PUBLIC_HOLD_BANK="Vietcombank · 0123456789 · DO DINH THANG"
NEXT_PUBLIC_HOLD_MOMO="0900000000"

# ---------- Mã QR chuyển khoản (chuẩn VietQR / NAPAS 247) ----------
# Bỏ trống -> ô QR tự ẩn, người dùng quay về lối gõ tay (vẫn chuyển khoản được bình
#             thường, chỉ hay gõ sai mã hơn -> khoản tiền rơi về đối soát tay).
# Có       -> banner cọc & hoá đơn trang trí hiện mã quét được: SỐ TIỀN và NỘI DUNG
#             tự điền sẵn trong app ngân hàng, không còn khe cho lỗi gõ.
#
# Ba biến này TÁCH RA từ NEXT_PUBLIC_HOLD_BANK ở trên: chuỗi đó để cho người đọc,
# còn QR cần từng phần riêng. Vẫn phải điền cả hai.
#   1. NEXT_PUBLIC_HOLD_BANK_CODE: mã ngắn, BIN hoặc tên ngân hàng — nhận cả ba dạng.
#      Tra đúng giá trị ở https://vietqr.app/banks.json (vd "VCB", "970436", "Vietcombank")
#   2. NEXT_PUBLIC_HOLD_ACCOUNT:   số tài khoản nhận tiền, CHỈ chữ và số
#   3. NEXT_PUBLIC_HOLD_NAME:      tên chủ tài khoản, KHÔNG DẤU (in dưới ảnh QR)
#
# ⚠️ Là biến BUILD-TIME: đổi trên Vercel phải **Redeploy**, restart không ăn thua.
# ⚠️ Trước khi mở cho người thật: quét thử bằng ít nhất 3 app ngân hàng khác nhau và
#    chuyển một khoản NHỎ THẬT, kiểm BankTxn có bóc đúng mã không. QR sai một trường
#    là tiền vào tài khoản người khác.
NEXT_PUBLIC_HOLD_BANK_CODE=""
NEXT_PUBLIC_HOLD_ACCOUNT=""
NEXT_PUBLIC_HOLD_NAME=""

# ---------- Gửi email mã xác minh (đăng ký / quên mật khẩu) ----------
# Chưa cấu hình -> app chạy "chế độ demo": mã 6 số hiện thẳng trên màn hình
#                  (đủ để test luồng, nhưng KHÔNG dùng được khi mở cho người thật).
# Có cấu hình   -> gửi email thật qua Resend (resend.com, free tier ~3.000 email/tháng).
#   1. Tạo tài khoản Resend -> API Keys -> tạo key, dán vào RESEND_API_KEY
#   2. Chưa có domain riêng thì để nguyên RESEND_FROM mặc định (onboarding@resend.dev)
RESEND_API_KEY=""
RESEND_FROM="ChicChic <onboarding@resend.dev>"

# ---------- Kho ảnh/video (Supabase Storage) ----------
# Bỏ trống -> nút "chụp ảnh" ẩn đi, app quay về lối dán đường dẫn (đủ để chạy thử,
#             nhưng KHÔNG dùng được thật: cô chú ngoài vườn không dán URL được).
# Có -> nông dân bấm một cái là mở camera, ảnh nén sẵn rồi tải thẳng lên Supabase.
#   1. Supabase -> Storage -> New bucket, tên "chicchic", BẬT "Public bucket"
#      (ảnh chuồng hiện trong thẻ <img> nên bucket phải đọc được tự do)
#   2. Settings -> API: chép "Project URL" vào SUPABASE_URL
#   3. Cùng trang, mục "service_role" -> chép vào SUPABASE_SERVICE_ROLE_KEY
#      ⚠️ Key này KHÔNG bao giờ để lộ ra client — chỉ dùng ở server để ký URL tải lên.
#   4. Đặt cả 3 biến này trên Vercel nữa, rồi deploy lại.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="chicchic"

# ---------- Webhook ngân hàng (SePay) — tự xác nhận thanh toán ----------
# Bỏ trống -> POST /api/webhooks/sepay trả 503 (ĐÓNG, không phải mở tự do). Mọi khoản
#             tiền vẫn phải đối soát tay ở /admin — app chạy bình thường, chỉ chậm hơn.
# Có       -> tiền về tài khoản là chuồng tự kích hoạt / trang trí tự mở khoá.
#   1. sepay.vn -> đăng ký, liên kết tài khoản ngân hàng nhận tiền
#   2. Tích hợp webhooks -> Thêm Webhook:
#      · URL           = https://<domain>/api/webhooks/sepay
#      · Sự kiện       = Có tiền vào       · Kiểu dữ liệu = JSON
#      · Gửi lại khi lỗi = BẬT             (SePay thử lại tối đa 7 lần)
#      · Xác thực      = API Key           <- KHÔNG chọn "Không xác thực": endpoint này
#                                             mở khoá hàng đã trả tiền, để trống là ai
#                                             cũng giả được một giao dịch.
#      · Cảnh báo khi lỗi liên tiếp = BẬT  (luồng tiền hỏng im lặng là tệ nhất)
#   3. Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#      Dán cùng một giá trị vào ô của SePay và vào biến dưới đây (cả trên Vercel).
SEPAY_WEBHOOK_KEY=""

# ---------- Khoá trang /admin ----------
# Có giá trị  -> /admin hỏi mật khẩu (Basic Auth, để trống tên đăng nhập).
# Bỏ trống    -> /admin mở tự do và hiện cảnh báo đỏ.
# BẮT BUỘC đặt trên Vercel trước khi chia link ra ngoài.
ADMIN_PASSWORD=""
