// ChicChic - data model
// Mô hình platform tổng quát: Farm → Zone → Barn(Chuồng) → Flock(Đàn) → Bird(Gà)
// Species/Breed là dữ liệu (dễ mở sang vịt/lợn/bò sau). Decor gắn ở CHUỒNG.
// Thanh toán để NGOÀI app ở PoC: Reservation lưu ý định + cọc, đối soát tay.

generator client {
  provider = "prisma-client-js"
  // ⚠️ ĐỪNG bật previewFeatures = ["relationJoins"]. Đã thử ở Prisma 5.22 và đo được
  // trang chuồng nhanh 3,9× - nhưng nó làm SẬP query engine: hai `findUnique` cùng
  // khai `relationLoadStrategy` rơi vào cùng một tick sẽ bị Prisma gộp lô và engine
  // panic (`Option::unwrap()` on None, query_document/mod.rs:280). Hai người cùng mở
  // /chuong/demo một lúc là đủ để dựng lại. Chi tiết ở CODEMAP §10.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supabase: cổng 6543, ?pgbouncer=true)
  directUrl = env("DIRECT_URL") // direct (Supabase: cổng 5432) - dùng cho migrate/db push
}

// ---------- Enums ----------
enum Species {
  CHICKEN
  // DUCK / PIG / CATTLE ... (mở rộng sau)
}

enum ProductLine {
  LAYER // gà đẻ - "pet có ích", đặt tên từng con
  BROILER // gà thịt - "đồng hành một mùa vụ", gắn theo chuồng
}

enum FlockStage {
  BROODING // úm
  GROWING
  // ⭐ Chỉ đặt được khi có QUẢ TRỨNG ĐẦU TIÊN kèm ảnh trong sổ thu hoạch (CODEMAP §9.30).
  // Việc nền chạy theo lịch cố ý KHÔNG bao giờ đặt trạng thái này.
  LAYING // đang đẻ (layer)
  FINISHING // sắp thu hoạch (broiler)
  // "Hết chu kỳ, chờ chủ chuồng quyết định" - dùng cho CẢ HAI dòng: gà đẻ hết chu kỳ đẻ,
  // gà thịt tới ngày xuất chuồng. Cố ý không tách thành hai giá trị: hai giá trị cùng một
  // ý nghĩa nghiệp vụ sẽ bắt mọi guard và mọi việc nền phải nhớ kiểm cả hai. Khác biệt
  // chỉ ở CÁCH GỌI trên màn hình → `lib/flock.stageLabel()`.
  END_OF_LAY // → offer thịt/nghỉ hưu/lứa mới ở /chuong/<slug>/ket-chu-ky
  HARVESTED
  RETIRED
}

enum BirdStatus {
  ALIVE
  SICK
  UNDER_TREATMENT
  DECEASED
  HARVESTED
  RETIRED
}

enum ReservationStatus {
  HELD // đã giữ chỗ (cọc), chờ đối soát
  CONFIRMED // đã xác nhận thanh toán
  ACTIVE // đang nuôi
  COMPLETED
  CANCELLED
}

// Trạng thái cọc - thanh toán vẫn NGOÀI app (chuyển khoản/MoMo), app theo dõi đối soát.
enum PaymentStatus {
  UNPAID // chưa chuyển
  REPORTED // user bấm "đã chuyển" - chờ nông trại đối soát
  CONFIRMED // nông trại xác nhận đã nhận tiền → chuồng kích hoạt
}

enum ProductType {
  EGG
  MEAT
}

enum UpdateKind {
  NOTE
  PHOTO
  VIDEO
  CARE
  HEALTH
  DECOR
  MILESTONE
  RANGE // thả vườn / gọi về chuồng
}

enum HealthEventStatus {
  REPORTED
  TREATING
  RECOVERED
  DECEASED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum Role {
  USER
  WORKER // nông dân - đăng nhập vào cổng /nong-trai
  ADMIN
}

// Nhiệm vụ user giao cho nông dân, luôn gắn với MỘT chuồng cụ thể.
enum TaskKind {
  DECOR // lắp / xếp lại trang trí theo bố cục user vẽ
  RANGE_OUT // thả đàn ra vườn
  RANGE_IN // gọi đàn về chuồng
  FEED // cho ăn vào giờ user hẹn
  CHECK // ngó chuồng & quay lại hiện trạng
  GEAR // mặc / tháo yếm cho từng con gà
  DELIVER // giao một lô đã bán trên chợ cho người mua
  HARVEST // mổ + sơ chế + cân đàn rồi ghi lô MEAT vào sổ thu hoạch
  HANDOVER // giao lô tận nhà cho CHÍNH CHỦ chuồng (khác DELIVER: không có tiền đi kèm)
  FREEZE // chuyển một lô sang tủ đông theo yêu cầu của CHỦ LÔ (§9.2: app không tự đổi được)
  WEIGH // cân mẫu đàn gà thịt hằng tuần rồi ghi vào sổ lớn
}

enum TaskStatus {
  OPEN // nông dân chưa làm
  DONE // đã làm + có ảnh/video minh chứng
  DECLINED // không làm được, có lý do
}

// Lựa chọn cuối chu kỳ đẻ của layer - ngang hàng, không mặc định
enum EndOfLayChoice {
  MEAT // nhận thịt (gà mái hầm)
  RETIRE // cho nghỉ hưu ở nông trại
  RENEW // nuôi lứa mới
}

// Luật kết chu kỳ áp cho MỘT ĐÀN cụ thể (§11.51 · spec FL-D12/D13).
//
// `STANDARD`           - ba lựa chọn như xưa, không đổi gì.
// `FAMILY_RETIRE_ONLY` - đàn đang đồng hành cùng một gia đình có trẻ nhỏ: **chỉ RETIRE**.
//                        `MEAT` bị chặn vì FL-D12; `RENEW` bị hoãn vì FL-D13 - nhánh
//                        `RENEW` hiện tại **reset chính đàn đó** về `BROODING` chứ không
//                        lưu được số phận đàn cũ, nên với một đứa trẻ đã đặt tên cho từng
//                        con thì nó là "đàn của con biến mất, thay bằng đàn khác cùng
//                        tên chuồng" - không ai giải thích nổi. Mở lại `RENEW` cần thiết
//                        kế lịch sử nhiều lứa trước (§11 mục 26.7 của spec).
enum FlockLifecyclePolicy {
  STANDARD
  FAMILY_RETIRE_ONLY
}

// Trạng thái một lời mời / một suất tham gia Family Learning (spec §12.4).
//
// `INVITED`   - quản trị đã mời, cha mẹ chưa đụng vào. **Chưa khoá vòng đời đàn.**
// `ACTIVE`    - cha mẹ đã đồng ý; đây mới là lúc `Flock.lifecyclePolicy` bị khoá (Epic 2).
// `PAUSED`    - tạm dừng trải nghiệm số. **Không** đụng tới việc chăm đàn ngoài đời.
// `WITHDRAWN` - cha mẹ rút. Cam kết vòng đời **vẫn giữ nguyên** (spec §17.3).
// `COMPLETED` - chương trình kết thúc bình thường.
enum FamilyEnrollmentStatus {
  INVITED
  ACTIVE
  PAUSED
  WITHDRAWN
  COMPLETED
}

// Nhóm tuổi của trẻ (spec FL-D02). CỐ Ý là một khoảng chứ không phải ngày sinh: nội dung
// chỉ cần biết "đọc được chưa" để chọn bài, còn ngày sinh chính xác là dữ liệu định danh
// một đứa trẻ có thật - không thu (FL-D11, spec §17.2).
enum ChildAgeBand {
  AGE_5_6
  AGE_7_8
}

// Vòng đời một hồ sơ trẻ (spec §12.1).
//
// `DRAFT`             - cha mẹ vừa tạo, chưa đủ điều kiện vào khu của bé (thiếu assent).
// `ACTIVE`            - consent còn hiệu lực.
// `CONSENT_WITHDRAWN` - cha mẹ đã rút. Khoá khu của bé NGAY, dữ liệu còn đó để họ kịp
//                       nghĩ lại hoặc xin bản sao trước khi xoá (spec §17.3).
// `DELETION_PENDING`  - đã xin xoá, đang xoá.
// `DELETED`           - đã xoá. Dòng còn lại là bia mộ rỗng, giữ để cuống consent không
//                       mất theo (xem chú thích ở `ChildProfile.deletedAt`).
enum ChildProfileStatus {
  DRAFT
  ACTIVE
  CONSENT_WITHDRAWN
  DELETION_PENDING
  DELETED
}

// Một dấu mốc trong cuốn sổ consent (spec §12.3). CHỈ THÊM, không sửa, không xoá.
//
// `GRANTED`          - cha mẹ đồng ý.
// `ASSENTED`         - bé 7–8 tuổi tự nói "con đồng ý" bằng ngôn ngữ của bé.
// `WITHDRAWN`        - cha mẹ rút.
// `DELETE_REQUESTED` - cha mẹ xin xoá dữ liệu.
// `DELETED`          - đã xoá xong.
enum ConsentAction {
  GRANTED
  ASSENTED
  WITHDRAWN
  DELETE_REQUESTED
  DELETED
}

// ---------- Người dùng & nhân sự ----------
model User {
  id                String              @id @default(cuid())
  email             String              @unique
  // Tên đăng nhập cho tài khoản nông dân do admin cấp - các cô chú gõ "colan"
  // thay vì phải nhớ email. Tài khoản khách vẫn đăng nhập bằng email, cột này null.
  username          String?             @unique
  name              String?
  phone             String?
  role              Role                @default(USER)
  passwordHash      String? // scrypt "salt:hash" - null = tài khoản cũ chưa đặt mật khẩu
  emailVerifiedAt   DateTime? // đã xác minh OTP qua email
  sessions          Session[]
  reservations      Reservation[]
  barns             Barn[]              @relation("BarnOwner")
  tasksRequested    BarnTask[]          @relation("TaskRequester")
  workerProfile     FarmWorker?         @relation("WorkerAccount")
  notifications     Notification[]
  messages          BarnMessage[]
  decorOrders       DecorOrder[]
  events            Event[]
  listingsSold      MarketListing[]     @relation("ListingSeller")
  listingsBought    MarketListing[]     @relation("ListingBuyer")
  marketOrders      MarketOrder[]       @relation("OrderBuyer")
  payouts           Payout[]
  payoutAccount     PayoutAccount?
  address           Address?
  careOrders        CareOrder[]
  invoices          BarnInvoice[]
  refunds           Refund[]
  familyEnrollments FamilyEnrollment[]  @relation("FamilyParent")
  childProfiles     ChildProfile[]      @relation("ChildParent")
  childConsents     ChildConsentEvent[] @relation("ConsentParent")
  createdAt         DateTime            @default(now())
}

// Loại thông báo - quyết định icon hiện trên chuông.
enum NotifyKind {
  TASK_NEW // nông dân: có việc mới được giao
  TASK_DONE // chủ chuồng: việc đã xong, có ảnh minh chứng
  TASK_DECLINED // chủ chuồng: nông dân báo không làm được
  TASK_CANCELLED // nông dân: chủ chuồng rút lại việc
  BARN_UPDATE // chủ chuồng: tin/ảnh mới từ chuồng
  PAYMENT // chủ chuồng: cọc đã được đối soát
  BARN_ASSIGNED // nông dân: được giao một chuồng mới
  BARN_RETURNED // nông dân: chuồng được hoàn trả về nông trại
  ACCOUNT // tài khoản: admin tạo, đổi mật khẩu…
  MILESTONE // mốc vòng đời đàn
  MESSAGE // hộp thư của chuồng: phía bên kia vừa nhắn
}

// Thông báo hiện trên hình chuông ở thanh trên. Mỗi hành động hoàn tất
// (của chủ chuồng hay của nông dân) đều đẩy một dòng vào đây cho phía còn lại.
model Notification {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      NotifyKind
  title     String
  body      String?
  href      String? // bấm vào thông báo thì đi đâu
  readAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Phiên đăng nhập - token ngẫu nhiên trong cookie httpOnly
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // ⭐ Lần gần nhất người này gõ lại mật khẩu để chứng minh **chính họ đang ngồi đây**.
  //
  // Phiên sống 30 ngày; một cái máy mở sẵn trong nhà là 30 ngày ai chạm vào cũng là "đã đăng
  // nhập". Với việc thường thì đổi được, nhưng ba việc dưới đây thì không: tạo hồ sơ một đứa
  // trẻ · rút consent · xoá dữ liệu của bé. Cột này là cửa thứ hai cho đúng ba việc đó
  // (spec §17.1), hiệu lực ngắn - xem `RECENT_AUTH_MS` ở `lib/family-gates.ts`.
  //
  // Nằm trên `Session` chứ không phải `User`: xác minh ở máy này không mở cửa cho máy khác.
  reauthAt DateTime?

  @@index([userId])
}

enum EmailCodePurpose {
  REGISTER
  RESET
}

// Mã OTP gửi về email - đăng ký & quên mật khẩu. Một mã active cho mỗi (email, mục đích).
model EmailCode {
  id        String           @id @default(cuid())
  email     String
  purpose   EmailCodePurpose
  codeHash  String // sha256 của mã 6 số - không lưu mã trần
  attempts  Int              @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([email, purpose])
}

// Bộ đếm của hàng rào tần suất (§11.50). Một dòng cho mỗi (ngăn, khoá).
//
// Vì sao phải có bảng riêng: `messages.sendingBlocked` đếm được là nhờ mỗi tin nhắn tự nó
// đã là một dòng trong DB. Gửi OTP, đăng nhập và tra tên chủ tài khoản thì **không để lại
// dòng nào** để mà đếm - lượt gọi hỏng, lượt gọi sai mật khẩu, lượt tra không ra tên đều
// biến mất không dấu vết, trong khi tiền của nông trại thì đã tiêu.
//
// Vì sao trong DB chứ không trong bộ nhớ: mỗi lượt gọi trên Vercel có thể rơi vào một tiến
// trình khác, và tiến trình nguội đi thì mất sạch. Một bộ đếm trong RAM ở đây là bộ đếm
// đếm nhầm - nó chỉ nhìn thấy một phần lưu lượng và không bao giờ chạm ngưỡng.
//
// `windowAt` = mốc mở cửa sổ hiện hành, KHÔNG phải lần gọi cuối. Cron dọn dòng cũ.
model RateLimit {
  id       String   @id @default(cuid())
  bucket   String // tên ngăn - khớp `TenNhip` trong lib/nhip-meta.ts
  key      String // email / tên đăng nhập / địa chỉ mạng / id người dùng
  count    Int      @default(1)
  windowAt DateTime @default(now())

  @@unique([bucket, key])
  @@index([windowAt])
}

// Nông dân - "farmer-in-the-loop": lớp niềm tin chống-đa-cấp.
// Có tài khoản riêng (User role=WORKER) để đăng nhập vào cổng /nong-trai nhận việc.
model FarmWorker {
  id           String        @id @default(cuid())
  name         String
  area         String // vd "Ba Vì, Hà Nội"
  bio          String?
  birthYear    Int? // để hiện tuổi; lưu năm sinh nên không bị cũ theo thời gian
  avatarKey    String        @default("lan") // key -> illustration
  consentMedia Boolean       @default(false) // đồng thuận lên hình
  yearsExp     Int           @default(5)
  maxBarns     Int           @default(15) // trần số chuồng một nông dân nhận quản lý
  active       Boolean       @default(true) // còn nhận chuồng mới không
  user         User?         @relation("WorkerAccount", fields: [userId], references: [id])
  userId       String?       @unique
  farm         Farm          @relation(fields: [farmId], references: [id])
  farmId       String
  barns        Barn[]
  updates      FarmUpdate[]
  media        BarnMedia[]
  introMedia   WorkerMedia[]
  tasks        BarnTask[]
  weighIns     WeighIn[]
  lots         HarvestLot[]
}

// Ảnh/video cô chú tự giới thiệu bản thân - KHÁC BarnMedia (ảnh hiện trạng chuồng).
// Khách xem trước khi chọn người chăm chuồng của mình.
model WorkerMedia {
  id        String     @id @default(cuid())
  worker    FarmWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  type      MediaType
  url       String
  posterUrl String? // ảnh bìa cho video
  caption   String?
  sortOrder Int        @default(0) // nhỏ hơn hiện trước
  createdAt DateTime   @default(now())

  @@index([workerId, sortOrder])
}

// ---------- Hạ tầng farm ----------
model Farm {
  id      String       @id @default(cuid())
  name    String
  address String
  zones   Zone[]
  workers FarmWorker[]
}

model Zone {
  id     String @id @default(cuid())
  name   String
  farm   Farm   @relation(fields: [farmId], references: [id])
  farmId String
  barns  Barn[]
}

// CHUỒNG - đơn vị sở hữu, decorable + watchable
model Barn {
  id                String              @id @default(cuid())
  slug              String              @unique // đường dẫn /chuong/{slug}
  label             String
  zone              Zone                @relation(fields: [zoneId], references: [id])
  zoneId            String
  owner             User?               @relation("BarnOwner", fields: [ownerId], references: [id])
  ownerId           String?
  worker            FarmWorker?         @relation(fields: [workerId], references: [id])
  workerId          String?
  outside           Boolean             @default(false) // đàn đang ở vườn hay trong chuồng (broiler)
  isPublic          Boolean             @default(false) // chuồng trưng bày - ai cũng xem được dù đã có chủ
  flock             Flock?
  decor             BarnDecor[]
  updates           FarmUpdate[]
  media             BarnMedia[]
  reservation       Reservation?
  tasks             BarnTask[]
  messages          BarnMessage[]
  decorOrders       DecorOrder[]
  lots              HarvestLot[]
  decisions         LifecycleDecision[]
  careOrders        CareOrder[]
  invoices          BarnInvoice[]
  weighIns          WeighIn[]
  refunds           Refund[]
  familyEnrollments FamilyEnrollment[]
  // MỐC TÍNH TIỀN NUÔI của lứa ĐANG nuôi. `null` = lứa đầu, mốc là `reservation.paidAt`.
  //
  // Đặt lại mỗi lần chủ chuồng chọn "nuôi lứa mới" (`decideEndOfLay` nhánh RENEW). Trước
  // khi có cột này, mốc luôn là ngày cọc về, và với GÀ THỊT thì `soHoaDonCanCo` trả đúng
  // 1 mãi mãi ⟹ lứa thứ hai trở đi **không tốn đồng nào** (§11.17). Với gà đẻ thì ngược
  // lại: chuồng nằm ở `END_OF_LAY` hai tháng rồi mới bấm lứa mới sẽ bị **truy thu** cả
  // hai tháng không ai nuôi, vì số hoá đơn cần có vẫn đếm từ ngày cọc.
  billingFrom       DateTime?
  // Đã phát bao nhiêu hoá đơn TRƯỚC lứa hiện tại. `seq` vẫn là số thứ tự toàn cuộc đời
  // chuồng (khoá `@@unique([barnId, seq])` không đổi), còn kỳ thì tính từ `billingFrom`.
  billingSeqBase    Int                 @default(0)
  createdAt         DateTime            @default(now())

  @@index([workerId])
}

model Flock {
  id              String               @id @default(cuid())
  productLine     ProductLine
  species         Species              @default(CHICKEN)
  breed           Breed                @relation(fields: [breedId], references: [id])
  breedId         String
  feedingPlan     FeedingPlan          @relation(fields: [feedingPlanId], references: [id])
  feedingPlanId   String
  stage           FlockStage           @default(BROODING)
  size            Int                  @default(0)
  startDate       DateTime             @default(now())
  // CAM KẾT VÒNG ĐỜI, chụp lên ĐÀN chứ không lên hồ sơ trẻ hay lên enrollment (§11.51).
  //
  // Vì sao chụp ở đây: một đứa trẻ đặt tên cho từng con mái rồi theo dõi chúng suốt mấy
  // tháng - đàn đó không được bất ngờ chuyển sang nhận thịt. Nếu cột này nằm trên hồ sơ
  // trẻ thì cha mẹ rút consent / xoá dữ liệu con là cam kết biến mất theo, và đàn gà thật
  // ngoài vườn lại mở đường vào lò mổ. Đây là **dữ liệu vận hành của nông trại**, không
  // phải dữ liệu trẻ em: không cascade, không reset khi xoá dữ liệu con (spec §17.4).
  lifecyclePolicy FlockLifecyclePolicy @default(STANDARD)
  // Ngày tiêm phòng úm theo quy định. NULL = chưa tiêm/chưa ghi nhận - trang truy
  // xuất phải nói thật là "chưa cập nhật", không được khẳng định bừa là đã tiêm.
  vaccinatedAt    DateTime?
  cycleDays       Int                  @default(75) // broiler: số ngày tới lứa; layer: độ dài chu kỳ đẻ
  barn            Barn                 @relation(fields: [barnId], references: [id])
  barnId          String               @unique
  birds           Bird[]
  products        Product[]
  healthEvents    HealthEvent[]
  weighIns        WeighIn[]
}

// SỔ LỚN - mỗi tuần nông dân cân MẪU một số con gà thịt rồi ghi vào đây.
//
// Vì sao có bảng này: một lứa gà thịt nuôi 75 ngày, và trong suốt 75 ngày đó app không
// nói được câu nào cụ thể về đàn ngoài "đang lớn". Chủ chuồng gà đẻ thì ngày nào cũng
// có trứng để nhìn; chủ chuồng gà thịt mở app ra thấy đúng một thanh tiến độ nhích một
// vạch - không có gì để mong, không có gì để kể với ai. Con số cân nặng là thứ **đổi
// mỗi tuần và đổi theo hướng tốt lên**, đúng thứ đang thiếu.
//
// ⚠️ §9.1 và §9.2: cân nặng là sự thật NGOÀI ĐỜI, không suy ra từ lịch được. Một dòng ở
// đây chỉ sinh ra khi nông dân hoàn thành việc `WEIGH` kèm ảnh cái cân - cùng luật với
// `HarvestLot`. Đừng bao giờ thêm đường ghi thứ hai, và đừng bao giờ "nội suy" số của
// tuần bị bỏ lỡ: một đường cong đẹp mà bịa thì đúng bằng lời hứa của kẻ đi lừa.
model WeighIn {
  id      String  @id @default(cuid())
  flock   Flock   @relation(fields: [flockId], references: [id], onDelete: Cascade)
  flockId String
  barn    Barn    @relation(fields: [barnId], references: [id], onDelete: Cascade)
  barnId  String
  // Tuần thứ mấy của lứa, tính từ `Flock.startDate`. Khoá chống trùng cùng `flockId`:
  // cân hai lần trong một tuần thì lần sau ĐÈ lên lần trước, không đẻ ra hai điểm.
  weekNo  Int
  // Cân nặng TRUNG BÌNH một con, đơn vị GAM. Gam chứ không phải kg vì gà con tuần đầu
  // chỉ ~150g - lưu kg thì thành 0.15 và mọi chỗ hiển thị phải tự nhân chia.
  avgGram Int
  // Cân mấy con để ra số đó. Bắt buộc ghi: "trung bình 1,8kg" của 3 con và của 20 con
  // là hai mức tin cậy khác hẳn nhau, giấu đi là để người đọc tự tưởng tượng.
  sample  Int     @default(1)
  note    String?

  worker       FarmWorker @relation(fields: [workerId], references: [id])
  workerId     String
  // Ảnh cái cân. Bắt buộc - §9.1.
  proofMedia   BarnMedia? @relation("WeighProof", fields: [proofMediaId], references: [id], onDelete: SetNull)
  proofMediaId String?    @unique
  weighedAt    DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@unique([flockId, weekNo])
  @@index([barnId, weighedAt])
}

model Bird {
  id      String     @id @default(cuid())
  tagCode String // vòng chân màu + số (PoC). Mã theo CHUỒNG.
  chipId  String? // RFID - MVP+
  name    String? // chỉ layer: đặt tên từng con
  status  BirdStatus @default(ALIVE)
  flock   Flock      @relation(fields: [flockId], references: [id])
  flockId String
  gear    BirdGear[] // yếm đang đeo / đang chờ mặc - xem model BirdGear

  @@index([flockId])
}

// ---------- Catalog (Breed / Feeding / Decor / HealthPackage) ----------
model Breed {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  species     Species @default(CHICKEN)
  layer       Boolean @default(true) // dùng được cho gà đẻ?
  broiler     Boolean @default(true) // dùng được cho gà thịt?
  story       String?
  layerNote   String?
  broilerNote String?
  flocks      Flock[]
}

model FeedingPlan {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  ratio           String // vd "20% cám : 80% ngô/thóc"
  priceMultiplier Float   @default(1)
  note            String?
  emoji           String  @default("🌾")
  flocks          Flock[]
}

model DecorItem {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  priceVnd  Int
  svgKey    String
  category  String           @default("khac") // nhóm hiển thị ở trang trang trí
  blurb     String? // mô tả ngắn - "vì sao món này đáng lắp"
  defaultX  Float            @default(120) // vị trí gợi ý khi mới lắp (toạ độ SVG 240x180)
  defaultY  Float            @default(120)
  sortOrder Int              @default(0)
  // Món MẶC LÊN GÀ (yếm), không lắp vào chuồng. Bán qua đúng DecorOrder như mọi món
  // khác - chỉ khác chỗ hàng đi đâu sau khi tiền về: `confirmDecorPaid` KHÔNG tạo
  // BarnDecor cho món này, nó nằm trong kho tới khi chủ chuồng chọn con gà để mặc.
  wearable  Boolean          @default(false)
  // Màu yếm - vừa để vẽ sprite, vừa là chấm màu cạnh tên gà ở trang Đàn gà.
  // Đây mới là lý do tính năng tồn tại: nhìn ảnh phải biết con nào là con Miu.
  colorHex  String?
  // "sang" | "toi" - chia hai nhóm ở cửa hàng. Sáng màu dễ thấy ngoài vườn,
  // tối màu ít lộ bẩn. Để String chứ không phải enum: thêm nhóm là việc của sản phẩm.
  tone      String?
  // ⭐ SỐ CÁI NÔNG TRẠI CÒN TRONG KHO THẬT. Đây là hàng có thật phải mua về, không
  // phải vật phẩm ảo sinh ra vô hạn.
  //
  // Trừ NGAY LÚC ĐẶT HOÁ ĐƠN (giữ hàng), không phải lúc xác nhận tiền: nếu đợi tới
  // lúc tiền về thì hai người cùng đặt cái cuối cùng, cả hai cùng chuyển khoản, và
  // một người mất tiền mà không có hàng. Huỷ hoá đơn thì trả lại kho.
  //
  // Phép trừ LUÔN là so-sánh-rồi-đặt trong một câu lệnh (§9.24) - xem
  // `decor-actions.takeStock`. Kiểm bằng `if` rồi mới trừ là để hở đúng khe cho hai
  // người cùng qua, và hậu quả là bán quá số hàng đang có.
  //
  // `prisma/seed.ts` CHỈ đặt cột này lúc `create`, không đụng lúc `update`: đây là số
  // liệu VẬN HÀNH của nông trại, không phải dữ liệu danh mục. Nông trại nhập thêm
  // hàng lên 50 rồi ai đó chạy seed mà bị kéo về 20 là mất hàng trong sổ.
  stockQty  Int              @default(20)
  installs  BarnDecor[]
  orderRows DecorOrderItem[]
  wornOn    BirdGear[]
}

// Yếm một con gà đang đeo (hoặc đang chờ nông dân mặc/tháo).
//
// VÌ SAO GẮN VÀO `Bird` CHỨ KHÔNG PHẢI `Barn`: app cho chủ chuồng đặt tên từng con
// mái, nhưng trong ảnh nông dân gửi về thì không ai phân biệt được con nào là con Miu
// - cái tên là một lời hứa rỗng. Yếm màu biến tên thành thứ nhận ra được bằng mắt.
// Gắn vào chuồng thì nó chỉ là món trang trí thứ 11.
//
// TRẠNG THÁI CHỈ ĐỔI TRONG `completeTask` (§9.2, y hệt `Barn.outside`): chủ chuồng bấm
// "mặc yếm đỏ cho con Miu" là TẠO VIỆC, không phải đã mặc. Ngoài đời cô Lan mặc xong,
// chụp ảnh con đó, thì trong app mới thành WORN.
model BirdGear {
  id        String     @id @default(cuid())
  bird      Bird       @relation(fields: [birdId], references: [id], onDelete: Cascade)
  birdId    String
  item      DecorItem  @relation(fields: [itemId], references: [id])
  itemId    String
  status    GearStatus @default(PENDING_ON)
  photoUrl  String? // ảnh/video con gà ĐÓ đang đeo - do completeTask ghi
  wornAt    DateTime?
  removedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([birdId, status])
  @@index([itemId, status])
}

enum GearStatus {
  PENDING_ON // chủ chuồng đã chọn, chờ nông dân mặc
  WORN // đã mặc, có ảnh minh chứng
  PENDING_OFF // chủ chuồng bấm tháo, chờ nông dân tháo
  OFF // đã tháo - CHỈ trạng thái này mới trả yếm về kho
}

// Decor đã lắp vào một chuồng thật (kèm ảnh chứng minh).
// x/y/scale/z do NGƯỜI DÙNG tự sắp xếp ở màn "Trang trí" - cô Lan lắp theo bản vẽ đó.
//
// CỐ Ý KHÔNG có @@unique([barnId, itemId]): một chuồng được lắp NHIỀU bản của cùng
// một món (3 chậu cây, 2 biển tên chữ khác nhau). Vì vậy mọi chỗ định danh "món đã
// lắp" phải dùng `id` của dòng này, KHÔNG dùng itemSlug - slug chỉ còn nói được
// "loại món", không còn nói được "cái nào".
model BarnDecor {
  id          String    @id @default(cuid())
  barn        Barn      @relation(fields: [barnId], references: [id])
  barnId      String
  item        DecorItem @relation(fields: [itemId], references: [id])
  itemId      String
  // Chữ chủ chuồng tự đặt cho món có mặt chữ (biển tên, bảng phấn).
  // null = dùng chữ mặc định (tên chuồng). Món không có mặt chữ thì bỏ qua cột này -
  // xem DECOR_TEXT trong lib/decor.ts để biết svgKey nào nhận chữ và dài bao nhiêu.
  text        String?
  // Màu và kiểu dáng của RIÊNG CÁI NÀY. Một chuồng mua 5 đoạn hàng rào thì mỗi đoạn
  // sơn một màu, chọn một kiểu (thẳng / cổng / rào thấp) - đó là chỗ người chơi tự
  // bày ra cái sân của mình. null = dùng màu/kiểu mặc định của món.
  //
  // Món nào nhận màu gì và có những kiểu nào thì tra `DECOR_COLORS` / `DECOR_VARIANTS`
  // trong lib/decor.ts (khoá theo `svgKey`) - đừng đoán ở tầng dữ liệu, y hệt cách
  // `DECOR_TEXT` đang làm với món có mặt chữ.
  colorHex    String?
  variant     String?
  x           Float     @default(120)
  y           Float     @default(120)
  scale       Float     @default(1)
  z           Int       @default(0) // thứ tự lớp - món chọn sau nổi lên trên
  flipped     Boolean   @default(false)
  installedAt DateTime  @default(now())
  photoUrl    String?

  @@index([barnId, z])
  @@index([barnId, itemId])
}

// Gói "An tâm" trả trước (khuyến nghị) - tránh upsell lúc gà ốm
model HealthPackage {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  priceVnd Int
  note     String?
}

// Sự cố sức khỏe - minh bạch, tính thuốc giá gốc, có bằng chứng
model HealthEvent {
  id              String            @id @default(cuid())
  flock           Flock             @relation(fields: [flockId], references: [id])
  flockId         String
  status          HealthEventStatus @default(REPORTED)
  description     String
  medsCostVnd     Int               @default(0) // giá gốc, itemize ở note
  evidenceUrl     String? // ảnh/video con gà bệnh
  vetNote         String?
  withdrawalUntil DateTime? // thời gian ngừng thuốc - không giao trứng/thịt
  createdAt       DateTime          @default(now())
}

// ---------- Sản phẩm & đơn ----------
model Product {
  id        String      @id @default(cuid())
  flock     Flock       @relation(fields: [flockId], references: [id])
  flockId   String
  type      ProductType
  qty       Int         @default(0)
  createdAt DateTime    @default(now())
}

// Lô hàng đang ở đâu trong vòng đời của nó.
enum LotStatus {
  AT_FARM // nông trại đang giữ hộ, chủ lô chưa nhận
  LISTED // đang rao trên chợ (đợt sau)
  SOLD // có người mua, chưa giao
  CLAIMED // CHÍNH CHỦ đã xin nhận hàng tận nhà, chờ nông dân giao
  DELIVERED // đã trao tay
  EXPIRED // quá hạn nông trại giữ hộ
}

// Giữ lô kiểu gì. Trứng nằm tủ mát, gà thịt nằm tủ đông - và người mua PHẢI biết
// điều đó: "gà tươi" với "gà đông lạnh" là hai món hàng khác nhau cả về giá lẫn
// kỳ vọng. Đừng bao giờ suy ra từ `type` rồi viết cứng vào giao diện (§9.11).
enum StorageMode {
  CHILLED // ngăn mát
  FROZEN // cấp đông
}

// SỔ THU HOẠCH - mỗi lần nông dân nhặt trứng hoặc mổ gà là một dòng ở đây.
//
// Vì sao cần bảng riêng thay vì cộng dồn vào `Product.qty`: một lô là một TÀI SẢN có
// chủ, có ngày thu, có hạn giữ, có ảnh chứng minh, và sau này bán lại được trên chợ.
// Một con số cộng dồn không mang nổi chừng đó. (`Product` giữ nguyên cho dữ liệu seed
// cũ; số trứng hiển thị từ nay suy từ bảng này - xem CODEMAP §11.11.)
//
// HẠN GIỮ **không có cột riêng**: luôn là `collectedAt + 7 ngày`. Lưu thành cột thì
// sớm muộn có dòng lệch với `collectedAt`, và lúc đó không biết tin cột nào.
model HarvestLot {
  id           String         @id @default(cuid())
  barn         Barn           @relation(fields: [barnId], references: [id], onDelete: Cascade)
  barnId       String
  flockId      String
  type         ProductType // EGG | MEAT
  qty          Int // EGG: số quả · MEAT: số con
  // MEAT tính tiền theo CÂN nên phải cân lúc mổ. Đây là con số nhạy cảm nhất của
  // luồng chợ: nông dân gõ tay và nó quyết định thẳng số tiền người mua trả - nên nó
  // đi kèm ảnh minh chứng, bị chặn khoảng ở server, và KHÔNG sửa được sau khi ghi.
  weightKg     Float?
  storage      StorageMode?
  // EGG: lúc nhặt · MEAT: lúc mổ. Mốc đếm hạn 7 ngày.
  collectedAt  DateTime       @default(now())
  worker       FarmWorker     @relation(fields: [workerId], references: [id])
  workerId     String
  proofMedia   BarnMedia?     @relation("LotProof", fields: [proofMediaId], references: [id], onDelete: SetNull)
  proofMediaId String?        @unique
  // Chủ lô LÚC THU. Cố ý tách khỏi `Barn.ownerId`: chuồng đổi chủ thì lô cũ vẫn
  // thuộc về người đã trả tiền nuôi nó.
  ownerId      String?
  status       LotStatus      @default(AT_FARM)
  note         String?
  // Mã trong đường dẫn công khai `/tx/<mã>` mà mã QR trỏ tới.
  //
  // CỐ Ý không dùng `id`: id rò ra ở nhiều chỗ nội bộ (log, form, thuộc tính DOM), mà
  // mã này là một CHÌA KHOÁ - ai cầm được đường dẫn là xem được trang truy xuất. Tách
  // ra thì sau này thu hồi một mã chỉ là ghi lại một cột.
  //
  // Nullable vì lô tạo trước bản này không có mã; trang công khai coi "không có mã" là
  // không tồn tại. `logHarvest` sinh mã cho mọi lô mới.
  publicCode   String?        @unique
  listing      MarketListing?
  // Chính chủ xin nhận hàng tận nhà lúc nào.
  claimedAt    DateTime?
  // CHỤP LẠI địa chỉ giao ngay lúc xin nhận - cùng luật với `Payout.bankSnapshot`:
  // người ta đổi địa chỉ tháng sau thì sổ cũ vẫn phải nói đúng hàng đã đi về đâu.
  // Nông dân đọc chính cột này, KHÔNG đọc `Address` hiện tại của chủ lô.
  deliverTo    Json?
  createdAt    DateTime       @default(now())

  @@index([barnId, collectedAt])
  @@index([ownerId, status])
  @@index([status, collectedAt])
}

// VÙNG GIAO HÀNG - nông trại khai được nhận chở tới đâu, và tới đó tốn bao nhiêu.
//
// Vì sao là một BẢNG chứ không phải hằng số trong mã: đây là chuyện nông trại đổi theo
// mùa, theo giá xăng, theo việc có ai đi hướng đó không - người trực phải tự sửa được ở
// `/admin` mà không cần deploy. Cùng lý do với `MarketPrice`.
//
// Vì sao là Ô CHỌN chứ không đoán từ chuỗi địa chỉ: đoán "Hà Nội" từ một dòng chữ người
// dùng tự gõ là trò đoán mò, và đoán sai ở đây nghĩa là hoặc thu nhầm tiền, hoặc hứa
// giao tới một nơi không ai đi tới. Cùng bài học với ô chọn ngân hàng ở Đợt 9.
//
// ⚠️ **Không có dòng nào ⟹ không giao tới đâu cả.** Đó là mặc định đúng: thà không nhận
// đơn còn hơn nhận rồi không giao được. Seed đặt sẵn Hà Nội (miễn phí) + vài tỉnh lân cận.
model DeliveryZone {
  id        String    @id @default(cuid())
  name      String    @unique // "Hà Nội", "Hoà Bình", "Tỉnh khác"
  // 0 = freeship. Phí này là của MỘT CHUYẾN, không phải của một lô - xem `MarketOrder`.
  feeVnd    Int       @default(0)
  active    Boolean   @default(true) // tắt tạm thời mà không mất địa chỉ ai đang trỏ vào
  sortOrder Int       @default(0)
  addresses Address[]
  createdAt DateTime  @default(now())

  @@index([active, sortOrder])
}

// Nơi giao hàng cho CHÍNH CHỦ chuồng, và **từ Đợt 13 cũng là nơi giao đơn chợ**.
//
// Một người MỘT địa chỉ, giống `PayoutAccount` - cố ý không làm sổ địa chỉ nhiều dòng
// kèm "mặc định": ở quy mô này nó chỉ thêm một màn quản lý mà không ai cần, và mỗi lô
// đã tự chụp lại địa chỉ vào `HarvestLot.deliverTo` lúc xin nhận nên đổi địa chỉ không
// làm sai đơn đang giao.
model Address {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String        @unique
  fullName  String // người nhận
  phone     String // nông dân gọi trước khi tới
  line      String // số nhà, đường, phường/xã, quận/huyện, tỉnh - một dòng
  note      String? // "gọi trước 15 phút", "cổng xanh cuối ngõ"…
  // Vùng giao. NULL = địa chỉ có từ trước Đợt 13, chưa ai chọn vùng - những địa chỉ đó
  // vẫn đọc được (đơn đang giao không được gãy) nhưng **không đặt hàng mới được** cho
  // tới khi người dùng mở ô địa chỉ và chọn vùng. Xem `lib/delivery.thieuVungGiao`.
  zone      DeliveryZone? @relation(fields: [zoneId], references: [id])
  zoneId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([zoneId])
}

// ---------- Chợ nông trại ----------
//
// KHÔNG phải chợ rao vặt: hàng không rời nông trại. Người bán không nhận được hàng
// (bận, đi xa) thì chuyển QUYỀN NHẬN lô đó cho người khác, và nông trại giao thẳng cho
// người mua. Nhờ vậy không có khoảng trống an toàn thực phẩm khi chuyển tay, và truy
// xuất không đứt - lô vẫn gắn chuồng, vẫn có ảnh, vẫn chịu `HealthEvent.withdrawalUntil`.

// GIÁ NIÊM YẾT do nông trại quy định - người bán KHÔNG tự đặt giá.
//
// Đổi giá = THÊM DÒNG MỚI, không sửa dòng cũ: hoá đơn cũ phải tra lại được đúng giá
// lúc bán (cùng luật với `DecorOrderItem.priceVnd`).
model MarketPrice {
  id            String      @id @default(cuid())
  type          ProductType // EGG | MEAT
  // null = áp cho MỌI giống. Trứng dùng dòng null (giá như nhau); gà thịt có dòng
  // riêng theo từng giống - gà Mía và gà Đông Tảo không thể cùng giá.
  breedSlug     String?
  // EGG: đồng/quả · MEAT: đồng/KG (nên `HarvestLot.weightKg` là bắt buộc với gà thịt).
  unitVnd       Int
  effectiveFrom DateTime    @default(now())
  note          String?
  createdAt     DateTime    @default(now())

  @@index([type, breedSlug, effectiveFrom])
}

enum ListingStatus {
  LISTED // đang rao
  RESERVED // có người bấm mua, chờ tiền về
  PAID // tiền đã về, chờ nông dân giao
  DELIVERED // đã trao tay người mua
  CANCELLED
}

enum MarketOrderStatus {
  OPEN // giỏ hàng - đang gom lô, chưa có mã chuyển khoản
  RESERVED // đã chốt giỏ, có mã, chờ tiền về
  // Người mua đã bấm "Tôi đã chuyển khoản" - cùng nghĩa với `PaymentStatus.REPORTED`
  // của cọc / trang trí / hoá đơn nuôi. ⚠️ Đơn ở đây **không bao giờ bị việc nền huỷ**
  // (§9.34): tiền của họ có thể đang trên đường, nhả lô ra là vừa mất hàng vừa nhận tiền.
  REPORTED
  PAID // tiền đã về, chờ nông dân giao
  DELIVERED // đã trao tay
  CANCELLED
}

// MỘT ĐƠN HÀNG CHỢ - thứ người mua thật sự trả tiền cho.
//
// Trước Đợt 13, mỗi `MarketListing` tự mang `payCode` riêng: mua 3 lô là **ba lần chuyển
// khoản** với ba nội dung khác nhau, và người mua phải làm đúng cả ba. Nay giỏ hàng gom
// chúng lại thành một đơn, một mã, một lần chuyển.
//
// ⚠️ VÌ SAO ĐƠN HÀNG VÀ PHÍ GIAO PHẢI RA ĐỜI CÙNG NHAU: phí giao là phí **một chuyến**
// (§11.43). Không có thực thể đơn thì không có chỗ nào để treo đúng một phí - hoặc phải
// tính phí trên từng lô (thu tiền cho thứ không xảy ra), hoặc phải đoán xem những lô nào
// "đi chung một chuyến" lúc giao. Đơn hàng chính là câu trả lời cho câu hỏi đó.
//
// Trạng thái `OPEN` **là cái giỏ**. Không có bảng giỏ riêng: một người một giỏ đang mở,
// và lô trong giỏ đã ở `RESERVED` nên vẫn chịu đúng luật giữ chỗ như trước - người khác
// đoạt được nếu để quá lâu. Nhờ vậy không có khái niệm "giữ chỗ" thứ hai để đồng bộ.
//
// ⚠️ Hạn giữ chỗ là **3 giờ** kể từ lúc bỏ vào giỏ (`RESERVE_HOLD_MINUTES`), tính SUỐT
// cả bước chuyển khoản - không phải 3 giờ cho giỏ rồi thêm 3 giờ nữa cho việc trả tiền.
// Mốc đếm nằm ở `MarketListing.reservedAt` (lúc vào giỏ), KHÔNG ở `MarketOrder.reservedAt`
// (lúc chốt): đếm lại từ lúc chốt là cho người ta gia hạn vô hạn bằng cách chốt lại.
model MarketOrder {
  id          String            @id @default(cuid())
  buyer       User              @relation("OrderBuyer", fields: [buyerId], references: [id])
  buyerId     String
  status      MarketOrderStatus @default(OPEN)
  // Mã nội dung chuyển khoản (CHICM…). NULL khi còn là giỏ - chưa chốt thì chưa có gì
  // để chuyển. Sinh lúc `chotGio`, và **không đổi** sau đó.
  payCode     String?           @unique
  // Ba con số CHỐT LÚC CHỐT GIỎ. Nông trại đổi phí giao ngày mai KHÔNG đổi đơn hôm nay -
  // cùng luật với giá của tin đăng. `totalVnd` luôn = `goodsVnd + shipVnd`.
  goodsVnd    Int               @default(0)
  shipVnd     Int               @default(0)
  totalVnd    Int               @default(0)
  // Địa chỉ + tên khu vực CHỤP LẠI lúc chốt (`lib/harvest.DeliverTo`). Người mua đổi địa
  // chỉ tháng sau thì chuyến đang đi vẫn phải nói đúng nó đi về đâu.
  deliverTo   Json?
  zoneName    String?
  reservedAt  DateTime? // lúc chốt giỏ
  // Lúc người mua bấm "Tôi đã chuyển khoản". Cùng vai với `Reservation.reportedAt`:
  // đây là mốc người trực dùng để biết khoản nào đang chờ đối soát lâu nhất.
  reportedAt  DateTime?
  paidAt      DateTime?
  deliveredAt DateTime?
  listings    MarketListing[]
  task        BarnTask? // việc giao của ĐÚNG đơn này
  createdAt   DateTime          @default(now())

  // Một người chỉ có MỘT giỏ đang mở. Postgres coi mọi NULL là khác nhau nên khoá này
  // chỉ ràng buộc đúng hàng `OPEN`… không - nó ràng buộc mọi trạng thái, nên KHÔNG dùng
  // được ở đây. Luật "một giỏ" cưỡng chế trong `market-actions.gioDangMo` bằng
  // findFirst-rồi-create; va chạm ở đây chỉ tạo ra một giỏ thừa rỗng, không mất tiền ai.
  @@index([buyerId, status])
  @@index([status, reservedAt])
}

model MarketListing {
  id          String        @id @default(cuid())
  lot         HarvestLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId       String        @unique // một lô một tin đăng
  // Đơn hàng đang gom lô này. NULL = chưa ai bỏ vào giỏ (đang rao), hoặc tin đăng có từ
  // trước Đợt 13. Đặt `SetNull` để huỷ đơn không kéo theo tin đăng của người bán.
  order       MarketOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     String?
  seller      User          @relation("ListingSeller", fields: [sellerId], references: [id])
  sellerId    String
  // Ba số CHỐT LÚC ĐĂNG từ `MarketPrice`. Người bán không tự nhập giá, và nông trại
  // đổi giá hôm sau KHÔNG đổi tin đăng hôm trước.
  //
  // `netVnd` luôn = `priceVnd − feeVnd`, KHÔNG tính riêng bằng `× 0,8`: hai phép làm
  // tròn độc lập lệch 1đ ở một số giá trị, và một đồng lệch trong sổ tiền là một giờ
  // đối soát.
  priceVnd    Int
  feePercent  Int
  feeVnd      Int
  netVnd      Int
  status      ListingStatus @default(LISTED)
  buyer       User?         @relation("ListingBuyer", fields: [buyerId], references: [id])
  buyerId     String?
  // ⚠️ Từ Đợt 13 mã chuyển khoản nằm ở `MarketOrder.payCode`, KHÔNG sinh vào đây nữa.
  // Cột này giữ lại để đọc đơn cũ (`resolvePayCode` vẫn tra được mã đã in ra ngoài đời).
  payCode     String?       @unique // CHICM… - chỉ còn ở đơn TRƯỚC Đợt 13
  reservedAt  DateTime? // mốc để tự nhả chỗ nếu người mua không trả tiền (§ chợ)
  paidAt      DateTime?
  deliveredAt DateTime?
  payout      Payout?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
}

enum PayoutStatus {
  PENDING // chờ nông trại chuyển tiền cho người bán
  PAID
  FAILED
}

// CHI TRẢ cho người bán. Ở PoC luôn làm TAY: tự động đẩy tiền ra là chỗ sai một lần
// mất tiền thật. Chỉ sinh khi lô đã DELIVERED - không giao thì không chi.
model Payout {
  id           String        @id @default(cuid())
  listing      MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId    String        @unique
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  amountVnd    Int
  status       PayoutStatus  @default(PENDING)
  // Số tài khoản LÚC CHI, chụp lại thành JSON. Không đọc lại hồ sơ khi đối chiếu:
  // người ta đổi tài khoản sau thì sổ cũ vẫn phải nói đúng tiền đã đi về đâu.
  bankSnapshot Json
  proofUrl     String? // ảnh biên lai chuyển khoản
  adminNote    String?
  // Lúc người bán bấm "Rút tiền về tài khoản".
  //
  // KHÔNG phải một trạng thái mới: khoản tiền đã là của họ từ lúc lô được giao (§9.29),
  // cột này chỉ ghi lại việc họ đã LÊN TIẾNG. Trước bản này người bán không có cách nào
  // nói "cho tôi xin tiền" - họ chỉ ngồi chờ, còn người trực nông trại thì không phân
  // biệt được ai đang chờ gấp với ai chưa để ý. Hàng đợi ở /admin nay xếp người đã yêu
  // cầu lên trước.
  requestedAt  DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
  @@index([userId, status])
}

// Tài khoản nhận tiền của người bán. Bắt buộc điền TRƯỚC khi đăng bán - thiếu nó thì
// tiền về mà không biết trả cho ai, và người bán chờ trong vô vọng.
model PayoutAccount {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName   String
  accountNo  String
  holderName String
  updatedAt  DateTime @updatedAt
}

// Reservation = "đặt mua trước + dịch vụ nuôi hộ" (KHÔNG phải đầu tư)
model Reservation {
  id               String            @id @default(cuid())
  user             User              @relation(fields: [userId], references: [id])
  userId           String
  barn             Barn?             @relation(fields: [barnId], references: [id])
  barnId           String?           @unique
  productLine      ProductLine
  breedSlug        String
  feedingPlanSlug  String
  henNames         String[] // layer: tên user đặt
  healthPlanOptIn  Boolean           @default(false)
  priceEstimateVnd Int
  depositVnd       Int               @default(50000)
  status           ReservationStatus @default(HELD)
  paymentStatus    PaymentStatus     @default(UNPAID)
  // Mã nội dung chuyển khoản (CHICC…). Unique + có chỉ mục: webhook tra đúng một dòng
  // thay vì `id endsWith` (LIKE '%…') quét cả bảng mỗi lần tiền về. Nullable vì đơn
  // tạo trước khi có cột này được bù sau; mọi đơn mới đều có.
  payCode          String?           @unique
  reportedAt       DateTime? // lúc user bấm "tôi đã chuyển khoản"
  paidAt           DateTime? // lúc nông trại xác nhận nhận được tiền
  // Chống double-submit: client gửi kèm key, gọi lại cùng key trả về đúng đơn cũ.
  idemKey          String?           @unique
  createdAt        DateTime          @default(now())
}

// Nhật ký cập nhật từ nông trại - LUÔN đóng dấu tên nông dân (farmer stamp)
model FarmUpdate {
  id        String      @id @default(cuid())
  barn      Barn        @relation(fields: [barnId], references: [id])
  barnId    String
  worker    FarmWorker  @relation(fields: [workerId], references: [id])
  workerId  String
  kind      UpdateKind  @default(NOTE)
  text      String
  mediaUrl  String? // giữ để tương thích ngược; ảnh/video mới nằm ở BarnMedia
  media     BarnMedia[]
  createdAt DateTime    @default(now())

  @@index([barnId, createdAt])
}

// Ảnh & video hiện trạng chuồng - thứ người dùng mở app để xem mỗi ngày.
// PoC: dán URL (Supabase Storage / YouTube). MVP: upload trực tiếp.
model BarnMedia {
  id          String      @id @default(cuid())
  barn        Barn        @relation(fields: [barnId], references: [id], onDelete: Cascade)
  barnId      String
  worker      FarmWorker? @relation(fields: [workerId], references: [id])
  workerId    String?
  type        MediaType   @default(PHOTO)
  url         String // ảnh: URL ảnh. video: URL mp4 hoặc link YouTube.
  posterUrl   String? // ảnh bìa cho video
  caption     String?
  durationSec Int?
  capturedAt  DateTime    @default(now()) // thời điểm QUAY/CHỤP - dùng để gom theo ngày
  update      FarmUpdate? @relation(fields: [updateId], references: [id], onDelete: SetNull)
  updateId    String?
  taskProof   BarnTask?   @relation("TaskProof") // ảnh/video nông dân chụp sau khi làm xong việc
  lotProof    HarvestLot? @relation("LotProof") // ảnh giỏ trứng / con gà lúc cân
  weighProof  WeighIn?    @relation("WeighProof") // ảnh cái cân lúc cân mẫu hằng tuần
  createdAt   DateTime    @default(now())

  @@index([barnId, capturedAt])
}

// NHIỆM VỤ - user giao cho nông dân phụ trách chuồng của mình.
// Nguyên tắc: nông dân chỉ tích hoàn thành được KHI có ảnh/video minh chứng
// chụp sau khi làm (proofMediaId), nên "đã xong" luôn có bằng chứng đi kèm.
model BarnTask {
  id            String       @id @default(cuid())
  barn          Barn         @relation(fields: [barnId], references: [id], onDelete: Cascade)
  barnId        String
  worker        FarmWorker   @relation(fields: [workerId], references: [id])
  workerId      String
  requestedBy   User?        @relation("TaskRequester", fields: [requestedById], references: [id])
  requestedById String?
  kind          TaskKind
  title         String
  note          String? // lời nhắn của user
  dueAt         DateTime? // FEED: giờ hẹn cho ăn
  // ĐƠN CHỢ mà việc `DELIVER` này phục vụ. `@unique` là chốt "một đơn một việc giao".
  //
  // ⚠️ Đây là chỗ vá một lỗ có thật (§11.44): trước Đợt 13 việc `DELIVER` gộp theo
  // CHUỒNG, nên hai người khác nhau mua hai lô cùng chuồng chỉ sinh MỘT việc, ghi chú
  // của người sau đè người trước, và một tấm ảnh đóng cả hai đơn rồi sinh cả hai
  // `Payout` - đúng cái lỗ mà `HANDOVER` đã được tách ra để tránh (§9.1).
  order         MarketOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       String?      @unique
  status        TaskStatus   @default(OPEN)
  seenAt        DateTime? // nông dân đã mở hộp việc → hết "mới"
  doneAt        DateTime?
  doneNote      String? // nông dân ghi lại / lý do không làm được
  // NHÃN MỘT CHẠM cô chú gắn lúc báo xong (spec §18.3 · FL-D24, Epic 7). Một khoá trong
  // danh sách ĐÓNG ở `lib/van-hanh-meta.NHAN_CHAM_SOC`, hoặc `null`.
  //
  // ⚠️ **Không bắt buộc, và cố ý không bao giờ trở thành bắt buộc.** Mục tiêu §4 của spec
  // là nông dân tăng tải ≤30 phút/nông trại/tuần; một trường bắt buộc trên đường "báo xong"
  // là thứ đứng chắn giữa một người đang đứng ngoài chuồng và việc họ vừa làm.
  //
  // Đổi lại cô chú được gì: nhãn **thay** câu ghi chú mặc định, nên gắn nhãn là bớt gõ chứ
  // không phải thêm việc. Còn phía trong: `CHECK` gộp ba mong muốn khác nhau của bé (kiểm
  // tra nước · dọn ổ đẻ · chụp cận cảnh) thành một loại việc, nên không có nhãn thì báo cáo
  // pilot không phân biệt nổi cô chú thật sự đã làm gì.
  careTag       String?
  proof         BarnMedia?   @relation("TaskProof", fields: [proofMediaId], references: [id], onDelete: SetNull)
  proofMediaId  String?      @unique
  createdAt     DateTime     @default(now())

  @@index([workerId, status, createdAt])
  @@index([barnId, createdAt])
}

// HOÁ ĐƠN TRANG TRÍ - decor là món TRẢ PHÍ, không phải quà tặng.
//
// Luồng: chọn món → đặt mua (UNPAID) → chuyển khoản → báo đã chuyển (REPORTED)
// → nông trại đối soát (CONFIRMED) → LÚC ĐÓ món mới vào chuồng và nông dân mới
// nhận việc lắp. Chưa xác nhận thì không xếp đặt được gì - cùng luật với cọc chuồng.
//
// Dùng lại enum PaymentStatus của Reservation: cùng một khái niệm "tiền ngoài app,
// đối soát tay", không đẻ thêm enum song song để rồi lệch nhau.
model DecorOrder {
  id            String           @id @default(cuid())
  barn          Barn             @relation(fields: [barnId], references: [id], onDelete: Cascade)
  barnId        String
  user          User             @relation(fields: [userId], references: [id])
  userId        String
  // Tổng TÍNH LẠI Ở SERVER lúc đặt (§9.6) - không nhận từ client.
  totalVnd      Int
  paymentStatus PaymentStatus    @default(UNPAID)
  // Mã nội dung chuyển khoản (CHICD…) - xem chú thích ở Reservation.payCode.
  payCode       String?          @unique
  reportedAt    DateTime?
  paidAt        DateTime?
  items         DecorOrderItem[]
  createdAt     DateTime         @default(now())

  @@index([barnId, createdAt])
  @@index([paymentStatus, createdAt])
}

model DecorOrderItem {
  id       String     @id @default(cuid())
  order    DecorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  item     DecorItem  @relation(fields: [itemId], references: [id])
  itemId   String
  // Số cái mua trong dòng này. Mua thêm lần sau là một DecorOrder khác, nên tổng số
  // cái chuồng SỞ HỮU = tổng qty của mọi dòng thuộc hoá đơn đã CONFIRMED
  // (lib/decor-store.ownedCounts) - đừng đếm số dòng.
  qty      Int        @default(1)
  // Giá MỘT CÁI, LÚC MUA. Bảng giá đổi thì hoá đơn cũ không được đổi theo.
  priceVnd Int

  @@unique([orderId, itemId])
}

// Kết quả đối soát một giao dịch ngân hàng.
enum BankTxnStatus {
  MATCHED // bóc được mã, tìm đúng đơn, đủ tiền → đã tự xác nhận
  UNMATCHED // không bóc được mã hoặc không có đơn nào khớp → admin xử lý tay
  DUPLICATE // đơn đã được xác nhận trước đó (chuyển thừa / bấm nhầm)
  MISMATCH // đúng đơn nhưng số tiền không đủ → KHÔNG tự xác nhận
}

// SỔ GIAO DỊCH NGÂN HÀNG - mọi khoản tiền vào do webhook SePay đẩy về, kể cả khoản
// không khớp đơn nào.
//
// Vì sao ghi cả khoản không khớp: người gõ sai nội dung chuyển khoản là chuyện thường.
// Nếu chỉ ghi khoản khớp thì khách gọi "em chuyển rồi mà" và nông trại không có gì
// để tra. Bảng này là bằng chứng duy nhất về phía app rằng tiền đã về.
model BankTxn {
  id            String        @id @default(cuid())
  // ID giao dịch bên SePay - CHỐNG TRÙNG. SePay gửi lại tối đa 7 lần khi server lỗi,
  // không có ràng buộc unique này thì một lần server hụt hơi = xác nhận hai lần.
  providerId    String        @unique
  gateway       String // tên ngân hàng
  accountNumber String?
  amountVnd     Int
  content       String // nội dung chuyển khoản thô
  code          String? // mã bóc được (CHICC…/CHICD…), null nếu không bóc được
  matchedKind   String? // "COC" | "DECOR"
  matchedId     String? // id Reservation / DecorOrder khớp được
  status        BankTxnStatus @default(UNMATCHED)
  note          String? // lý do không khớp, cho admin đọc
  // Payload gốc - giữ nguyên để còn đối chất với nhà cung cấp khi có tranh chấp.
  raw           Json
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
  @@index([createdAt])
}

// Ai viết một tin nhắn, tính theo vai LÚC GỬI.
enum MessageAuthor {
  OWNER // chủ chuồng
  WORKER // nông dân phụ trách
}

// HỘP THƯ CỦA CHUỒNG - chỗ chủ chuồng hỏi một câu mà không phải bịa ra một việc.
//
// Vì sao gắn vào CHUỒNG chứ không phải vào cặp người: quyền hạn dùng lại nguyên
// cổng đang có (chủ chuồng / nông dân phụ trách), không phải phát minh mô hình
// quyền thứ hai. Đổi nông dân thì lịch sử ở lại với chuồng cho người mới đọc.
//
// Tin nhắn KHÔNG đổi hiện thực: muốn ai làm gì ngoài đời thì vẫn phải qua BarnTask
// và vẫn phải có ảnh minh chứng (§9.1, §9.2). Có nút "Chuyển thành việc" để nối
// hai thứ đó lại mà không phá ranh giới.
model BarnMessage {
  id       String        @id @default(cuid())
  barn     Barn          @relation(fields: [barnId], references: [id], onDelete: Cascade)
  barnId   String
  sender   User          @relation(fields: [senderId], references: [id])
  senderId String
  // Vai LÚC GỬI. Nông dân có thể bị thay, chủ chuồng có thể hoàn trả chuồng -
  // suy ngược từ quan hệ hiện tại sẽ làm sai lịch sử hộp thư.
  author   MessageAuthor
  body     String

  // Nghi trao đổi ngoài app (số điện thoại/Zalo/link). Chỉ gắn cờ, KHÔNG chặn gửi:
  // chặn nhầm số hotline nông trại còn hại hơn là để lọt.
  flagged      Boolean   @default(false)
  // Một bên bấm "báo cáo" → mở khoá cho quản trị đọc. Không có cờ và không bị báo
  // cáo thì admin KHÔNG đọc được hộp thư này.
  reportedAt   DateTime?
  // Loại vi phạm người báo cáo đã chọn - danh sách đóng ở lib/messages-meta.REPORT_REASONS.
  // Để String chứ không phải enum: thêm/bớt lý do là việc của sản phẩm, không đáng
  // phải migrate DB mỗi lần đổi chữ.
  reportReason String?
  // Admin ẩn tin vi phạm. Không xoá cứng - hộp thư là lưu vết khi có tranh chấp.
  hiddenAt     DateTime?
  // Phía bên kia đã mở hộp thư sau khi tin này được gửi.
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([barnId, createdAt])
  @@index([barnId, readAt])
}

// Ghi nhận quyết định cuối chu kỳ đẻ (giữ lịch sử qua nhiều lứa của một chuồng)
// HOÁ ĐƠN TIỀN NUÔI - khoản chính của cả sản phẩm, và là khoản duy nhất trước đây
// KHÔNG có cơ chế thu nào cả.
//
// Trước bảng này, `Reservation` chỉ thu `depositVnd` = 50.000đ; toàn bộ `priceEstimateVnd`
// (tiền nuôi + công + thức ăn + gói "An tâm") nằm đó như một con số ƯỚC TÍNH mà không ai
// đòi. Chuồng kích hoạt ngay sau khi cọc về, rồi nông trại nuôi thật, tốn thật.
//
// HAI DÒNG, HAI NHỊP (chốt với chủ dự án):
//   · BROILER - giá tính "/ lứa" ⟹ **một hoá đơn duy nhất**, `seq = 1`.
//   · LAYER   - giá tính "/ tháng" ⟹ **hoá đơn mỗi tháng**, `seq` tăng dần.
// Bảng giá đã in "/ tháng" cho gà đẻ từ đầu, nên gộp trọn 140 ngày vào một hoá đơn
// ~970.000đ là nói khác với thứ người ta đã đọc lúc mua.
//
// `@@unique([barnId, seq])` là CHỐT CHỐNG TRÙNG, không phải để tra cứu: hoá đơn được sinh
// ra lúc người dùng mở trang, mà người dùng thì mở hai tab cùng lúc. Không có ràng buộc
// này thì hai lần render song song đẻ ra hai hoá đơn cho cùng một tháng.
model BarnInvoice {
  id            String        @id @default(cuid())
  barn          Barn          @relation(fields: [barnId], references: [id], onDelete: Cascade)
  barnId        String
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  // 1 = hoá đơn đầu (kỳ đã trừ cọc). Gà đẻ thì 2, 3… là các tháng sau.
  seq           Int
  periodFrom    DateTime
  periodTo      DateTime
  // Giá của kỳ này, CHỤP LẠI lúc phát hành. Bảng giá đổi thì hoá đơn cũ không đổi theo.
  grossVnd      Int
  // Cọc trừ vào - CHỈ hoá đơn đầu mới > 0. Chủ dự án chốt: cọc 50k đi vào tiền hàng chứ
  // không giữ riêng rồi hoàn lại.
  creditVnd     Int           @default(0)
  // Số thật phải chuyển = grossVnd − creditVnd. Tính ở SERVER (§9.6).
  totalVnd      Int
  paymentStatus PaymentStatus @default(UNPAID)
  // Mã nội dung chuyển khoản (CHICN…) - xem chú thích ở Reservation.payCode.
  payCode       String?       @unique
  // Quá mốc này mà chưa trả thì chuồng bị khoá TRONG APP. Xem §9.33.
  dueAt         DateTime
  reportedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@unique([barnId, seq])
  @@index([paymentStatus, dueAt])
  @@index([userId, createdAt])
}

// Đơn NUÔI DƯỠNG đàn nghỉ hưu - trả trước theo khối tháng.
//
// Vì sao trả trước theo khối chứ không phải hoá đơn hằng tháng: mọi khoản tiền trong sản
// phẩm này đi bằng CHUYỂN KHOẢN TAY + ĐỐI SOÁT TAY. Hoá đơn hằng tháng nghĩa là 12 lần
// chuyển khoản mỗi năm cho MỘT đàn, và mỗi lần lỡ là một cuộc trò chuyện khó xử về đàn
// gà mà người ta có tình cảm. Một lần trả cho 3/6/12 tháng thì hợp với hạ tầng đang có,
// và hợp với cách sản phẩm đã bán gói "An tâm" (cũng trả trước).
//
// ⚠️ `monthlyVnd` là ẢNH CHỤP GIÁ LÚC MUA, y như `DecorOrderItem.priceVnd`: đổi
// `RETIRE_CARE_VND` trong bảng giá KHÔNG được đổi đơn cũ.
//
// ⚠️ Đọc §9.32 trước khi thêm bất cứ thứ gì vào đây: hết hạn nuôi dưỡng KHÔNG BAO GIỜ
// được sinh ra hậu quả lên con gà.
model CareOrder {
  id            String        @id @default(cuid())
  barn          Barn          @relation(fields: [barnId], references: [id], onDelete: Cascade)
  barnId        String
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  // Đàn được nuôi dưỡng - chốt lúc đặt, để sổ sau này còn biết tiền trả cho đàn nào.
  flockId       String
  months        Int
  // Giá MỘT THÁNG, LÚC MUA. Bảng giá đổi thì đơn cũ không được đổi theo.
  monthlyVnd    Int
  // Tổng TÍNH LẠI Ở SERVER (§9.6) - không nhận từ client.
  totalVnd      Int
  paymentStatus PaymentStatus @default(UNPAID)
  // Mã nội dung chuyển khoản (CHICR…) - xem chú thích ở Reservation.payCode.
  payCode       String?       @unique
  // Khoảng thời gian đơn này phủ. Chỉ đặt KHI TIỀN ĐÃ VỀ - đơn chưa trả thì hai cột này
  // `null`, nên "đã phủ tới bao giờ" luôn đọc được bằng `max(coversTo)` của các đơn
  // CONFIRMED mà không phải lọc thêm điều kiện nào.
  coversFrom    DateTime?
  coversTo      DateTime?
  reportedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([barnId, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([coversTo])
}

// ---------- Hoàn tiền ----------
// Nguồn tiền được trả lại. Không dùng quan hệ Prisma vì ba bảng khác nhau; `sourceId`
// trỏ tay tới `BarnInvoice.id` / `CareOrder.id` / `MarketListing.id`.
enum RefundKind {
  INVOICE // tiền nuôi của những ngày chưa nuôi
  CARE // nuôi dưỡng đàn nghỉ hưu, phần chưa dùng
  MARKET // đơn chợ: hàng không đúng, hoặc không tới
}

enum RefundStatus {
  REQUESTED // người dùng đã nêu, nông trại chưa xét
  APPROVED // nông trại đồng ý, chờ chuyển khoản
  PAID // đã chuyển trả
  REJECTED // từ chối, phải có lý do
}

// MỘT KHOẢN NÔNG TRẠI NỢ NGƯỜI DÙNG.
//
// Dựng đối xứng với `Payout` (tiền nợ người bán) và cố ý giống nó tới từng cột: chi trả
// TAY, có ảnh biên lai, có ghi chú của người trực. Ở quy mô này tự động đẩy tiền ra là
// chỗ sai một lần mất tiền thật.
//
// ⚠️ `@@unique([kind, sourceId])` là CỔNG CHỐNG TRÙNG DUY NHẤT: một hoá đơn / một đơn
// chợ chỉ đẻ ra đúng một dòng hoàn tiền, dù người ta bấm hai lần hay hai tab cùng gửi.
// Đừng thay bằng "đếm rồi tạo" - đó là để hở đúng khe giữa hai câu lệnh, và hậu quả ở
// đây là trả tiền hai lần cho cùng một kỳ.
model Refund {
  id           String       @id @default(cuid())
  user         User         @relation(fields: [userId], references: [id])
  userId       String
  // Chuồng liên quan, nếu có. `SetNull` vì chuồng có thể được giao cho người khác sau
  // này, mà sổ tiền thì không được mất dòng.
  barn         Barn?        @relation(fields: [barnId], references: [id], onDelete: SetNull)
  barnId       String?
  // Tên chuồng CHỤP LẠI lúc tạo. Chuồng đổi tên hay đổi chủ thì sổ cũ vẫn đọc đúng.
  barnLabel    String?
  kind         RefundKind
  sourceId     String
  // Số app ĐỀ XUẤT, tính ở server theo tỉ lệ ngày chưa dùng (§9.6 - không nhận từ client).
  amountVnd    Int
  // Số THẬT đã chuyển. Người trực có thể trả khác (làm tròn lên, cộng bù phí ngân hàng),
  // và lúc đó sổ phải nói đúng số đã đi khỏi tài khoản, không phải số app tính ra.
  paidVnd      Int?
  // Lý do người dùng viết. Bắt buộc với đơn chợ, để trống được khi hoàn trả chuồng.
  reason       String?
  adminNote    String?
  status       RefundStatus @default(REQUESTED)
  // Tài khoản nhận LÚC CHI, chụp thành JSON - y hệt `Payout.bankSnapshot`.
  bankSnapshot Json?
  proofUrl     String? // ảnh biên lai chuyển khoản
  decidedAt    DateTime?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())

  @@unique([kind, sourceId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model LifecycleDecision {
  id           String         @id @default(cuid())
  barn         Barn           @relation(fields: [barnId], references: [id])
  barnId       String
  flockId      String
  choice       EndOfLayChoice
  retireFeeVnd Int            @default(0)
  note         String?
  createdAt    DateTime       @default(now())

  @@index([barnId, createdAt])
}

// ---------- Family Learning ----------
// Một suất tham gia chương trình học cho trẻ, gắn với MỘT chuồng và MỘT tài khoản cha mẹ
// (spec §12.4). Epic 1 mới dựng khung + đường mời của quản trị; hồ sơ trẻ, consent và
// `ChildBarnLink` là Epic 2.
model FamilyEnrollment {
  id       String @id @default(cuid())
  // `Restrict`: không cho xoá chuồng khi còn một suất đang sống. `admin-actions.deleteBarn`
  // kiểm trước và từ chối kèm lý do đọc được - cùng khuôn với phép chặn "chuồng còn tin
  // đăng đang giữ tiền" (§11.42). Xoá một chuồng mà một đứa trẻ đang theo dõi là đúng
  // loại thao tác không được phép im lặng thành công.
  barn     Barn   @relation(fields: [barnId], references: [id], onDelete: Restrict)
  barnId   String
  parent   User   @relation("FamilyParent", fields: [parentId], references: [id], onDelete: Restrict)
  parentId String

  status          FamilyEnrollmentStatus @default(INVITED)
  // Nhóm pilot - dùng để so cohort ở §4 của spec. Không chứa dữ liệu của ai.
  cohortKey       String
  // Bản cam kết mà gia đình này tham gia theo (`FAMILY_PROGRAM_VERSION`). Chụp lại chứ
  // không tra ngược từ code: đổi luật sau này thì gia đình cũ vẫn đọc được đúng thứ họ
  // đã đồng ý.
  programVersion  String
  lifecyclePolicy FlockLifecyclePolicy   @default(FAMILY_RETIRE_ONLY)

  // ⭐ CHỐT "một chuồng chỉ có MỘT suất đang sống", cưỡng chế ở tầng DB.
  //
  // Giữ `barnId` khi suất còn `INVITED`/`ACTIVE`/`PAUSED`, đặt về `null` khi đã kết thúc.
  // Postgres cho phép **nhiều `NULL`** trong một cột unique, nên chuồng có thể tham gia
  // lại sau này mà vẫn giữ nguyên lịch sử.
  //
  // Vì sao không kiểm bằng `if` rồi mới `create`: hai người trực cùng bấm mời một chuồng
  // là hai câu lệnh xen kẽ nhau, và cả hai cùng đọc được "chưa có suất nào" - đúng khe đã
  // đẻ ra §9.24. Prisma không khai được partial unique index, nên cột phụ này là cách
  // native để có được đúng ràng buộc đó.
  barnLiveKey String? @unique

  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?
  pausedAt   DateTime?
  endedAt    DateTime?
  // Vì sao suất này đang tạm dừng - một khoá trong danh sách ĐÓNG ở
  // `lib/van-hanh-meta.LY_DO_TAM_DUNG`, không phải chữ người trực gõ (Epic 7, §22.3).
  //
  // Đóng vì hai lý do. Một: câu này hiện ra trước mặt cha mẹ, và một ô chữ tự do ở màn
  // quản trị là một đường đưa chữ chưa ai đọc vào màn hình của người dùng. Hai: nó là thứ
  // đếm được ở bảng cohort - "pilot dừng vì cái gì" chỉ trả lời được khi lý do là một
  // trong mấy khoá, không phải mỗi lần một cách viết.
  //
  // Giữ lại sau khi mở lại: đây là lịch sử vận hành, và "suất này từng dừng vì cái gì"
  // là câu người đọc báo cáo pilot sẽ hỏi.
  pauseReason String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  children ChildBarnLink[]

  @@index([parentId, status])
  @@index([barnId, status])
}

// Hồ sơ một đứa trẻ, do CHA MẸ tạo và quản lý (spec §12.2).
//
// ⚠️ **Danh sách cột ở đây là một cam kết về quyền riêng tư, không phải một thiết kế bảng.**
// Bốn thứ CỐ Ý không có mặt, và không được thêm mà không quay lại đọc spec §17: ngày sinh ·
// trường/lớp · vị trí · ảnh hoặc giọng nói của trẻ. Repo này thu đúng ba thứ - biệt danh do
// cha mẹ đặt, nhóm tuổi, và một hình đại diện chọn từ danh sách đóng - vì đó là tất cả những
// gì cần để chọn đúng bài và gọi đúng tên bé. Thêm một cột nữa là một quyết định về dữ liệu
// của trẻ em, không phải một tiện ích.
//
// `parentId` cascade: xoá tài khoản cha mẹ thì hồ sơ con đi theo. Đây là hướng đúng - dữ
// liệu này tồn tại vì tài khoản đó, không phải vì nông trại.
model ChildProfile {
  id       String @id @default(cuid())
  parent   User   @relation("ChildParent", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String

  // Biệt danh do cha mẹ gõ, đã qua `cleanLine` và trần 20 ký tự. Giao diện có nhắc đừng
  // nhập họ tên đầy đủ; code không kiểm được điều đó nên lời nhắc phải rõ.
  nickname  String
  ageBand   ChildAgeBand
  // Khoá của một hình trong danh sách đóng ở `lib/family-gates.AVATAR_TRE`. KHÔNG phải
  // đường dẫn ảnh: người gọi không tự nạp được hình nào vào đây.
  avatarKey String

  status ChildProfileStatus @default(DRAFT)

  // Bản chính sách mà cha mẹ đã đọc lúc đồng ý. Chụp lại chứ không tra ngược từ code -
  // đổi lời văn sau này thì vẫn dựng lại được đúng thứ họ đã đọc.
  consentVersion String?
  consentedAt    DateTime?
  // Bé 7–8 tuổi tự nói đồng ý (spec §17.1). Null = chưa hỏi hoặc nhóm 5–6 không cần.
  assentedAt     DateTime?
  withdrawnAt    DateTime?
  // ⚠️ Xoá dữ liệu trẻ là **xoá thật rồi để lại bia mộ**: `nickname` và `avatarKey` bị bôi
  // trắng, mọi `ChildBarnLink` bị xoá hẳn, nhưng DÒNG NÀY ở lại. Lý do: `ChildConsentEvent`
  // cascade từ đây, nên xoá dòng này là xoá luôn cuốn sổ chứng minh mình đã làm đúng - đúng
  // thứ spec §17.4 dặn phải giữ tối thiểu. Bia mộ không còn gì đọc ra được về đứa trẻ.
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links         ChildBarnLink[]
  consentEvents ChildConsentEvent[]
  moments       LearningMoment[]
  receipts      LearningEventReceipt[]
  suggestions   ChildSuggestion[]

  @@index([parentId, status])
}

// Cuốn sổ consent - CHỈ THÊM (spec §12.3).
//
// Trạng thái nhanh nằm trên `ChildProfile` (đọc một lần là biết vào được hay không); bảng
// này là cuốn sổ để dựng lại **ai đồng ý cái gì, lúc nào, bằng cách nào**. Hai thứ đó phải
// đổi trong CÙNG một transaction, nếu không thì có ngày trạng thái nói một đằng, sổ nói một
// nẻo - và lúc cần tới cuốn sổ thì đã muộn.
model ChildConsentEvent {
  id       String       @id @default(cuid())
  child    ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId  String
  // `Restrict`: cuốn sổ không được biến mất vì ai đó xoá một tài khoản.
  parent   User         @relation("ConsentParent", fields: [parentId], references: [id], onDelete: Restrict)
  parentId String

  action        ConsentAction
  policyVersion String
  // Danh sách mục đích cha mẹ đã đồng ý, chụp tại thời điểm đó.
  purposes      Json
  // Bé có tự nói đồng ý không (chỉ có nghĩa với `ASSENTED`).
  childAssent   Boolean?
  // ⚠️ CHỈ cách xác minh (`password_reauth`) + mốc thời gian + bản chính sách. TUYỆT ĐỐI
  // không giấy tờ tuỳ thân, không mật khẩu, không địa chỉ mạng, không dữ liệu của trẻ.
  evidence      Json?

  createdAt DateTime @default(now())

  @@index([childId, createdAt])
}

// Nối một đứa trẻ với một suất tham gia (spec §12.4).
//
// Vì sao là bảng nối chứ không phải một cột trên `ChildProfile`: một hồ sơ trẻ thuộc về cha
// mẹ, không thuộc về chuồng. Nhà có hai chuồng, hoặc chuồng này khép vòng đời rồi tham gia
// lại bằng suất mới - bé vẫn là bé đó.
model ChildBarnLink {
  id           String           @id @default(cuid())
  child        ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId      String
  // `Restrict`: suất tham gia là hồ sơ nghiệp vụ của nông trại, không được biến mất vì
  // một thao tác bên phía dữ liệu trẻ.
  enrollment   FamilyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  enrollmentId String

  linkedAt   DateTime  @default(now())
  unlinkedAt DateTime?

  @@unique([childId, enrollmentId])
  @@index([enrollmentId, unlinkedAt])
}

// Bảy việc có thật ngoài đời mà bài học của bé được sinh ra từ đó (spec §12.6, §14.2).
enum DomainEventType {
  FAMILY_ENROLLED
  CARE_TASK_COMPLETED
  FLOCK_STAGE_CHANGED
  FIRST_EGG_RECORDED
  HARVEST_LOGGED
  LOT_CLAIMED
  HANDOVER_COMPLETED
}

// ⭐ HỘP THƯ ĐI (outbox) của nghiệp vụ - **không phải** bảng `Event` bên dưới.
//
// Hai bảng, hai nghĩa vụ khác hẳn nhau, và gộp lại là hỏng cả hai (FL-D14 của spec):
//  · `Event` (`lib/track.ts`) là **đo đạc**: nuốt lỗi, mất một dòng không sao, không ai
//    trông chờ nó xuất hiện.
//  · `DomainEvent` là **lời hứa**: một bài học của đứa trẻ phải xuất hiện ĐÚNG MỘT LẦN vì
//    ngoài đời vừa có một việc thật. Nên nó được ghi trong CÙNG transaction với việc thật:
//    nghiệp vụ quay đầu ⟹ sự kiện không tồn tại.
//
// `dedupeKey` là toàn bộ cơ chế chống-nhân-đôi (mẫu ở `lib/su-kien-meta.ts`). Ghi bằng
// `createMany({ skipDuplicates: true })` chứ không phải `create`: trong Postgres một lỗi
// khoá trùng làm **hỏng cả transaction** đang mở, nên "cứ ghi rồi bắt lỗi P2002" sẽ kéo
// theo việc của nông dân quay đầu. `ON CONFLICT DO NOTHING` thì lần bấm thứ hai lặng lẽ
// không ghi gì, đúng nghĩa "đây là một lần thử lại hợp lệ".
//
// ⚠️ `payload` KHÔNG được chứa: dữ liệu của trẻ · địa chỉ · số điện thoại · thông tin ngân
// hàng · tin nhắn · chữ người dùng gõ tự do (§9.38). Nó sẽ chảy vào màn hình của một đứa
// trẻ 5 tuổi qua materializer ở Epic 4.
model DomainEvent {
  id   String          @id @default(cuid())
  type DomainEventType

  // Đối tượng gốc sinh ra sự kiện, vd ("HarvestLot", <lotId>). CỐ Ý không phải khoá ngoại:
  // giống `Event.barnSlug`, đây là bản ghi lịch sử và phải sống sót cả khi đối tượng bị xoá.
  aggregateType String
  aggregateId   String
  barnId        String?
  flockId       String?

  dedupeKey     String @unique
  // Đổi hình dạng `payload` thì tăng số này, đừng sửa nghĩa của bản cũ: moment đã tạo cho
  // một đứa trẻ phải đọc được mãi mãi bằng đúng bản đã sinh ra nó.
  schemaVersion Int    @default(1)
  payload       Json

  // Lúc việc xảy ra NGOÀI ĐỜI (do nơi phát truyền vào), tách khỏi lúc dòng này được ghi.
  happenedAt DateTime
  createdAt  DateTime @default(now())

  moments  LearningMoment[]
  receipts LearningEventReceipt[]

  @@index([barnId, happenedAt])
  @@index([type, happenedAt])
}

enum LearningMomentStatus {
  AVAILABLE
  STARTED
  COMPLETED
  ARCHIVED
}

enum LearningReceiptStatus {
  CREATED
  SKIPPED
  FAILED
}

// Một khoảnh khắc học của một đứa trẻ, sinh ra từ MỘT việc có thật ngoài đời (spec §12.7).
//
// ⭐ `@@unique([childId, domainEventId])` là **toàn bộ** cơ chế "một sự kiện tạo tối đa một
// bài cho mỗi bé". Hai lần đồng bộ song song, hai tab, việc nền chạy chồng lên nút bấm của
// cha mẹ - tất cả đều đâm vào đúng ràng buộc này ở tầng DB, không phải ở tầng `if`.
//
// ⚠️ Hai cột `*Snapshot` là **chụp lại**, cố ý không phải khoá ngoại hay tra cứu lúc đọc:
//  · `contentSnapshot` - nội dung bài **lúc bé nhận được nó**. Sửa catalog sau này không
//    được làm đổi bài cũ: một đứa trẻ đang làm dở một bài mà câu chữ tự đổi dưới tay nó là
//    hỏng lòng tin, và bản ghi "bé đã học gì" cũng hết đọc được.
//  · `factSnapshot` - dữ kiện thật của bài (số trứng, chặng, id ảnh minh chứng). **Chỉ số,
//    nhãn đóng và id ảnh** - không tên người, không nhãn chuồng, không chữ ai gõ tự do
//    (§9.39). Tên gọi hiện tại được tra lúc vẽ, ở Epic 5.
model LearningMoment {
  id String @id @default(cuid())

  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId       String
  // `Restrict`: bài học của một đứa trẻ không được biến mất vì ai đó dọn bảng sự kiện.
  domainEvent   DomainEvent  @relation(fields: [domainEventId], references: [id], onDelete: Restrict)
  domainEventId String
  // CỐ Ý không phải khoá ngoại: suất tham gia có thể kết thúc rồi mở lại, còn cuốn nhật ký
  // của bé thì ở lại.
  enrollmentId  String

  unitKey         String
  contentVersion  Int
  status          LearningMomentStatus @default(AVAILABLE)
  contentSnapshot Json
  factSnapshot    Json
  // Lựa chọn của bé lúc hoàn thành - **chỉ khoá đóng**, không chữ tự do (Epic 5).
  completion      Json?

  availableAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  // Nhiệm vụ làm CÙNG cha mẹ ngoài đời (nấu một món, cùng đếm lại hộp trứng). Cột riêng chứ
  // không phải một cờ trong `completion`: hai hành động khác nhau ghi cùng một cột JSON là
  // đọc-sửa-ghi đè lên nhau (§9.24). Một cột, một người ghi, so-sánh-rồi-đặt.
  missionDoneAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([childId, domainEventId])
  @@index([childId, status, availableAt])
}

// Dấu "đã xét sự kiện này cho bé này rồi" (spec §12.7).
//
// Vì sao cần một bảng riêng bên cạnh `LearningMoment`: phần lớn sự kiện **không** sinh ra bài
// nào - chưa có bài cho loại đó, hoặc bé thuộc nhóm tuổi không có biến thể. Không ghi lại
// việc đã xét thì mỗi lần đồng bộ lại duyệt lại từ đầu đúng những sự kiện đó, mãi mãi.
// `reason` là **mã ngắn** (`khong-co-bai-cho-loai-nay`), không phải stack trace, không PII.
model LearningEventReceipt {
  id String @id @default(cuid())

  child         ChildProfile          @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId       String
  domainEvent   DomainEvent           @relation(fields: [domainEventId], references: [id], onDelete: Cascade)
  domainEventId String
  status        LearningReceiptStatus
  reason        String?
  momentId      String?

  createdAt DateTime @default(now())

  @@unique([childId, domainEventId])
  @@index([status, createdAt])
}

// ---------- Mong muốn của bé (spec §12.8 · FL-D06/D07 · FL-D21..D24) ----------

// Bốn loại mong muốn. Danh sách ĐÓNG - thêm loại thì phải trả lời được "cha mẹ làm gì
// với nó", nếu không thì đó là một cái nút không dẫn tới đâu.
enum ChildSuggestionKind {
  DECOR_WISH // bé thích một món trang trí ⟹ cha mẹ đi luồng trang trí bình thường (có giá, có kho, có đối soát)
  CURATED_FARM_QUESTION // bé muốn hỏi cô chú một câu ⟹ cha mẹ mở hộp thư của chuồng
  FAMILY_ACTIVITY_WISH // bé muốn cả nhà cùng làm gì đó ⟹ chuyện ngoài đời, app không làm gì cả
  CARE_WISH // bé mong đàn được chăm theo một cách ⟹ CHA MẸ một chạm biến thành việc thật (FL-D21/D22)
}

enum ChildSuggestionStatus {
  PENDING
  REVIEWED // cha mẹ đã ngó và ghi nhận (không có nghĩa là đã mua/đã làm)
  DECLINED
  EXPIRED // để lâu quá không ai trả lời - việc nền tự đóng, xem `jobs.hetHanMongMuon`
}

// ⚠️⚠️ **BẢNG NÀY KHÔNG CÓ SIDE EFFECT NÀO** (FL-D06/D07 · spec §16.2).
//
// Một dòng ở đây là **một câu nói của đứa trẻ**, không phải một đơn hàng, một việc hay một
// lệnh chi. Trẻ không bao giờ tạo `BarnTask`, không đổi tiền, không đổi trạng thái đàn.
// Cha mẹ mới là người thực hiện, ở một hành động khác, có cổng quyền riêng.
//
// ⚠️ **`optionKey` phải thuộc catalog đóng** ở `lib/de-xuat-meta.ts`, và **không có cột nào
// nhận chữ tự do của trẻ**: không lời nhắn, không ghi chú, không giọng nói. Một cột `note`
// thêm vào đây là một đường đưa chữ chưa ai duyệt của một đứa trẻ ra trước mắt người lớn -
// và là thứ không lấy lại được sau khi đã gửi đi.
model ChildSuggestion {
  id String @id @default(cuid())

  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId String
  // Chép sẵn chủ hồ sơ để hàng chờ của cha mẹ tra được bằng một chỉ mục, không phải join.
  // Không phải khoá ngoại: xoá dữ liệu bé là xoá dòng này theo `Cascade` ở trên rồi.
  parentId     String
  enrollmentId String

  kind      ChildSuggestionKind
  optionKey String
  status    ChildSuggestionStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  expiresAt  DateTime?

  @@index([parentId, status, createdAt])
  @@index([childId, createdAt])
}

// ---------- Đo đạc ----------
// Nhật ký sự kiện - nguồn dữ liệu DUY NHẤT để đo phễu, giữ chân và 5 chỉ số PoC.
// Tự làm thay vì gắn bên thứ ba: giữ đúng triết lý ít phụ thuộc của repo, và số
// liệu người dùng không rời khỏi DB của mình.
// Ghi qua lib/track.ts - nuốt lỗi, không bao giờ làm hỏng hành động chính.
model Event {
  id        String   @id @default(cuid())
  name      String // vd "barn_reserved", "egg_logged"
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  // CỐ Ý không phải khoá ngoại: sự kiện là bản ghi lịch sử, phải sống sót
  // cả khi chuồng bị xoá hay đổi chủ.
  barnSlug  String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  // Khối "Nhịp 7 ngày" ở /admin lọc theo MỖI createdAt (không kèm name/userId), nên
  // hai chỉ mục ghép ở trên không đỡ được - thiếu dòng này là quét cả bảng lớn nhất repo.
  @@index([createdAt])
}

// Dấu "đã nhắc rồi" của việc nền.
//
// Việc nền chạy MỖI NGÀY trên cùng một tập dữ liệu: một đàn nằm ở END_OF_LAY không
// quyết định thì ngày nào cũng thoả điều kiện nhắc. Không có bảng này thì chủ chuồng
// nhận đúng một dòng chuông đó mỗi sáng cho tới khi họ tắt chuông - và tắt chuông là
// mất luôn vòng lặp giữ chân của sản phẩm (§9.8: đừng dội chuông).
//
// `key` = "<loại nhắc>:<id đối tượng>". CỐ Ý không phải khoá ngoại: đối tượng bị xoá
// thì dòng này thành rác vô hại và được dọn theo tuổi, còn khoá ngoại thì mỗi lần xoá
// một hoá đơn lại phải nhớ dọn ở đây.
model Nudge {
  id     String   @id @default(cuid())
  key    String   @unique
  sentAt DateTime @default(now())

  @@index([sentAt])
}
