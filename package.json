{
  "name": "chicchic",
  "version": "0.1.0",
  "private": true,
  "description": "ChicChic - nền tảng nhận nuôi chuồng gà thật, chăm qua app. Scaffold PoC/MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && npm run db:check:lifecycle && npm run db:check:session && next build",
    "db:check:session": "node scripts/check-session-schema.cjs",
    "db:check:lifecycle": "node scripts/check-lifecycle-schema.cjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lifecycle:pg": "vitest run --config vitest.lifecycle.config.ts",
    "test:security:pg": "vitest run --config vitest.security.config.ts",
    "test:security:http": "node scripts/smoke-security.cjs",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "overrides": {
    "next": { "postcss": "^8.5.23" }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "15.5.25",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "3.2.7"
  }
}
